# Production environment for infra/docker-compose.prod.yml
# Copy to .env (next to the compose files) on the server and fill in real values.

# Protocol used to reach the app. Domain is present, but NO TLS cert is used,
# so it must be http. WebRTC (camera/mic) only works over https or localhost.
DOMAIN_PROTOCOL=http

# Public domain/IP served by the client entry point
DOMAIN=rkurce1c.beget.tech

# --- Postgres ---
POSTGRES_USER=videoapp
POSTGRES_PASSWORD=156381de003698c1567f976d0db02fda

# --- Auth (shared between gateway and signaling) ---
JWT_SECRET=45044e1ca1b51525bad35fb6c35f79fc969a9a9a1a34530796100195e986a47d
JWT_ACCESS_EXPIRES_IN=15m
JWT_REFRESH_EXPIRES_IN=7d

# --- TURN (must match static-auth-secret in infra/coturn/turnserver.conf) ---
# TURN runs on the server's public IP (TURN works over UDP, not via nginx/TLS)
TURN_SHARED_SECRET=20ffe3802595c0f0fd41920c91c03d8f60a8b81527dd1ef7b7420be5307d440c
TURN_URL=159.194.239.54:3478
TURN_TLS_URL=159.194.239.54:5349

# Comma-separated extra origins allowed by gateway CORS (optional; same-origin
# through client/nginx already works without it)
CORS_ORIGINS=http://rkurce1c.beget.tech