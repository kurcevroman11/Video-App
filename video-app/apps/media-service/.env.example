# ===== mediasoup =====
# Число Worker'ов (1 на ядро; максимум 4 из-за диапазона RTP-портов).
MEDIASOUP_WORKERS=2

# Диапазон RTP-портов для всех Worker'ов (делится между ними поровну).
MEDIASOUP_RTC_MIN_PORT=40000
MEDIASOUP_RTC_MAX_PORT=49999

# Публичный IP сервера для клиентов за NAT (обязателен в проде; тот же, что у coturn).
# Если не задан — автоматически берётся первый внешний IPv4 интерфейса.
MEDIASOUP_ANNOUNCED_IP=

# ===== gRPC =====
# Порт, на котором слушает gRPC-сервер media-service.
PORT=50052