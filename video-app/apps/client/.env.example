# Базовый URL REST API (gateway-service) + signaling (WebSocket).
# Для локальной разработки ОСТАВЬТЕ ПУСТЫМИ: клиент ходит по относительным путям,
# а Vite dev-server проксирует /auth,/rooms,/turn-credentials,/signaling на
# localhost:3000 / localhost:3002 (см. vite.config.ts). Реконфиг не нужен.
VITE_API_URL=
VITE_SIGNALING_URL=

# Прод: соберите с единым origin за nginx (API и WS через один домен).
# VITE_API_URL=https://rkvideoapp.ru
# VITE_SIGNALING_URL=https://rkvideoapp.ru