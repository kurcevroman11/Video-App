# Базовый URL REST API (gateway-service).
# Для локальной разработки:
VITE_API_URL=http://localhost:3000
# Для удалённого доступа через Dev Tunnels:
# VITE_API_URL=https://<hash>-3000.euw.devtunnels.ms

# URL signaling-service (WebSocket, порт 3002).
VITE_SIGNALING_URL=http://localhost:3002
# ВАЖНО: с другого устройства localhost указывает на то устройство.
# Используйте публичный туннель / домен:
# VITE_SIGNALING_URL=https://<hash>-3002.euw.devtunnels.ms