# ===== База данных (Prisma) =====
DATABASE_USER=postgres
DATABASE_PASSWORD=postgres
DATABASE_HOST=localhost
DATABASE_PORT=5432
DATABASE_NAME=gateway
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/gateway

# ===== JWT =====
# Сгенерировать: openssl rand -hex 32
JWT_SECRET=change-me-jwt-secret
JWT_ACCESS_EXPIRES_IN=15m
JWT_REFRESH_EXPIRES_IN=7d

# ===== room-service (gRPC) =====
ROOM_SERVICE_HOST=localhost
ROOM_SERVICE_PORT=50051

# ===== TURN credentials =====
# Временные креды (RFC draft-uberti-behave-turn-rest).
# Значение должно совпадать с static-auth-secret в infra/coturn/turnserver.conf.
TURN_SHARED_SECRET=change-me-turn-shared-secret
TURN_URL=localhost:3478
TURN_TLS_URL=localhost:5349